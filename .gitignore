# Build output. The bin folder itself is kept (via .gitkeep) so it exists in a
# fresh download and the build's "Select Output Folder" prompt has an answer.
bin/*
!bin/.gitkeep
*.prg
*.prg.debug.xml
*.iq

# Developer key - NEVER commit this. There is no way to recover it,
# and without it you cannot update a published app.
*.der
*.pem
developer_key*

# Editor. settings.json IS tracked - it carries the autofetch and type-check
# settings the project wants. launch.json is not, since the Monkey C extension
# generates it per machine.
.vscode/*
!.vscode/settings.json
