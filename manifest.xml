<?xml version="1.0"?>
<!--
  Target: epix Pro (Gen 2) 47mm / quatix 7 Pro - confirmed API level 5.2 in the
  SDK Manager. Built against SDK 9.2.0.

  minApiLevel is set to the device's own level rather than the 3.3.0 glance
  floor. Nothing in v0 needs a 5.x API, but declaring 5.2.0 stops the compiler
  rejecting anything introduced between 3.3 and 5.2 - the Communications error
  constants below are the likely candidates. Since only one device is targeted,
  this costs nothing today. When device support widens in v3, lower this and add
  explicit `has` checks for the APIs that older hardware lacks.

  VERIFY the product id against the SDK's own device folder names:
    %APPDATA%\Garmin\ConnectIQ\Devices
  Each subfolder is named with the device id. If it is not "epix2pro47mm",
  change it here - nothing else in the project depends on it.
-->
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
    <iq:application
        entry="UvGuardApp"
        id="fbc12f97fcf9479688c15a7647130c95"
        launcherIcon="@Drawables.LauncherIcon"
        minApiLevel="5.2.0"
        name="@Strings.AppName"
        type="watch-app">

        <iq:products>
            <iq:product id="epix2pro47mm"/>
        </iq:products>

        <iq:permissions>
            <iq:uses-permission id="Background"/>
            <iq:uses-permission id="Communications"/>
            <iq:uses-permission id="Positioning"/>
            <iq:uses-permission id="Sensor"/>
        </iq:permissions>

        <iq:languages>
            <iq:language>eng</iq:language>
        </iq:languages>

        <iq:barrels/>
    </iq:application>
</iq:manifest>
